# Copy to .env.local for local development, and set the same names in the
# host's environment variables when deploying.
#
# None of these may be prefixed VITE_. Anything named VITE_* is compiled
# into the browser bundle and served to every visitor; these are read by
# the handlers in api/, which run on the server.

# The assistant in the about-page cards. Free key from console.groq.com
AI_API_KEY=

# Optional: a different provider or model for the same handler.
# AI_BASE_URL=
# AI_MODEL=

# Contact form -> a push to your phone. @BotFather gives you the token;
# NOTIFICATIONS.md has the two minutes of setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: a copy of each message by email, via resend.com
# MAIL_API_KEY=
# MAIL_TO=
# MAIL_FROM=
